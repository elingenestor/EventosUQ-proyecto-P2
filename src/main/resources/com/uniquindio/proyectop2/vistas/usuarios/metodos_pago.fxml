<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.uniquindio.proyectop2.controladores.usuario.MetodosPagoControlador"
      spacing="12" alignment="CENTER_LEFT" prefWidth="760" prefHeight="500">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="10">
        <ComboBox fx:id="comboTipo" prefWidth="180"/>
        <TextField fx:id="txtNumero" promptText="Número" prefWidth="180"/>
        <TextField fx:id="txtTitular" promptText="Titular" prefWidth="220"/>
    </HBox>

    <HBox spacing="10">
        <Button text="Agregar" onAction="#agregarMetodoPago"/>
        <Button text="Eliminar seleccionado" onAction="#eliminarSeleccionado"/>
        <Button text="Volver" onAction="#volver"/>
    </HBox>

    <TableView fx:id="tablaMetodosPago" prefHeight="360">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="120"/>
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="160"/>
            <TableColumn fx:id="colNumero" text="Número" prefWidth="220"/>
            <TableColumn fx:id="colTitular" text="Titular" prefWidth="240"/>
        </columns>
    </TableView>

</VBox>
