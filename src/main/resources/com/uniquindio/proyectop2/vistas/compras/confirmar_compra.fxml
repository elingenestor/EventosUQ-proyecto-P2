<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.uniquindio.proyectop2.controladores.compras.ConfirmarCompraControlador"
            style="-fx-background-color: #0d0d1a;">

    <top>
        <VBox spacing="12" style="-fx-background-color: #1e1e2e; -fx-border-color: #3a3a5c; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets top="20" right="24" bottom="20" left="24"/>
            </padding>
            <children>
                <Label text="Confirmar compra" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"/>
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <children>
                        <VBox spacing="4" style="-fx-background-color: #1e1e2e; -fx-padding: 10 16; -fx-background-radius: 8; -fx-border-color: #3a3a5c; -fx-border-radius: 8; -fx-border-width: 1;">
                            <children>
                                <Label text="USUARIO" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #7c7caa;"/>
                                <Label fx:id="lblUsuario" text="-" style="-fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                            </children>
                        </VBox>
                        <VBox spacing="4" style="-fx-background-color: #1e1e2e; -fx-padding: 10 16; -fx-background-radius: 8; -fx-border-color: #3a3a5c; -fx-border-radius: 8; -fx-border-width: 1;">
                            <children>
                                <Label text="EVENTO" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #7c7caa;"/>
                                <Label fx:id="lblEvento" text="-" style="-fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                            </children>
                        </VBox>
                        <VBox spacing="4" style="-fx-background-color: #1e1e2e; -fx-padding: 10 16; -fx-background-radius: 8; -fx-border-color: #3a3a5c; -fx-border-radius: 8; -fx-border-width: 1;">
                            <children>
                                <Label text="FECHA" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #7c7caa;"/>
                                <Label fx:id="lblFecha" text="-" style="-fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <HBox spacing="20" style="-fx-background-color: transparent;">
            <padding>
                <Insets top="20" right="24" bottom="20" left="24"/>
            </padding>
            <children>
                <VBox spacing="12" prefWidth="460" style="-fx-background-color: #1e1e2e; -fx-background-radius: 8; -fx-border-color: #3a3a5c; -fx-border-radius: 8; -fx-padding: 16;" HBox.hgrow="ALWAYS">
                    <Label text="Asientos asignados" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"/>
                    <TableView fx:id="tblAsientos" prefHeight="410" styleClass="tabla-confirmar">
                        <columns>
                            <TableColumn fx:id="colFila" text="Fila" prefWidth="110"/>
                            <TableColumn fx:id="colNumero" text="Numero" prefWidth="110"/>
                            <TableColumn fx:id="colZona" text="Zona" prefWidth="180"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                    <Label fx:id="lblTotalBase" text="Subtotal: $0.00" style="-fx-font-size: 14px; -fx-text-fill: #FFFFFF; -fx-font-weight: bold;"/>
                </VBox>

                <VBox spacing="14" prefWidth="360" style="-fx-background-color: #1e1e2e; -fx-background-radius: 8; -fx-border-color: #3a3a5c; -fx-border-radius: 8; -fx-padding: 16;" HBox.hgrow="ALWAYS">
                    <Label text="Servicios adicionales" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"/>
                    <ListView fx:id="lstServicios" prefHeight="240"
                              style="-fx-background-color: #12122a; -fx-border-color: #2e2e4e; -fx-background-radius: 6; -fx-border-radius: 6; -fx-control-inner-background: #12122a; -fx-text-fill: #FFFFFF;"/>
                    <Label text="Metodo de pago" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"/>
                    <ComboBox fx:id="cmbMetodosPago" prefWidth="320"
                              style="-fx-background-color: #1e1e2e; -fx-border-color: #3a3a5c; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 4 8; -fx-text-fill: #FFFFFF;"/>
                </VBox>
            </children>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="20" style="-fx-background-color: #1e1e2e; -fx-border-color: #3a3a5c; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets top="16" right="24" bottom="16" left="24"/>
            </padding>
            <children>
                <Label fx:id="lblTotalFinal" text="Total estimado: $0.00"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #00e676;" HBox.hgrow="ALWAYS"/>
                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <children>
                        <Button text="Recalcular" onAction="#recalcularTotal"
                                style="-fx-background-color: transparent; -fx-border-color: #3a3a5c; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 10 18; -fx-cursor: hand;"/>
                        <Button text="Cerrar" onAction="#cerrarVentana"
                                style="-fx-background-color: transparent; -fx-border-color: #3a3a5c; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 10 18; -fx-cursor: hand;"/>
                        <Button text="Confirmar compra" onAction="#confirmarCompra"
                                style="-fx-background-color: #6c63ff; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 20; -fx-padding: 10 22; -fx-cursor: hand;"/>
                    </children>
                </HBox>
            </children>
        </HBox>
    </bottom>
</BorderPane>