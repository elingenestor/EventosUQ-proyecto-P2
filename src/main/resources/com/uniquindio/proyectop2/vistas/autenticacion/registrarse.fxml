<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.uniquindio.proyectop2.controladores.autenticacion.RegistrarseControlador"
      spacing="12" alignment="CENTER" style="-fx-background-color: #f8fafc;">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>
    <Label text="Crear cuenta" style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
    <TextField fx:id="txtNombreCompleto" promptText="Nombre completo" maxWidth="320"/>
    <TextField fx:id="txtCorreo" promptText="Correo electrónico" maxWidth="320"/>
    <TextField fx:id="txtTelefono" promptText="Teléfono" maxWidth="320"/>
    <PasswordField fx:id="txtContrasena" promptText="Contraseña" maxWidth="320"/>
    <PasswordField fx:id="txtConfirmarContrasena" promptText="Confirmar contraseña" maxWidth="320"/>
    <Button text="Registrarme" onAction="#registrarUsuario" maxWidth="320" prefWidth="320"/>
    <Button text="Volver" onAction="#volverALogin" maxWidth="320" prefWidth="320"/>
</VBox>
