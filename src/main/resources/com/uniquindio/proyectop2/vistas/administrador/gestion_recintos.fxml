<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.uniquindio.proyectop2.controladores.administrador.GestionRecintosControlador"
      spacing="12.0" style="-fx-background-color: white;">
    <padding>
        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
    </padding>
    <children>
        <Label text="Gestión de recintos" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <TableView fx:id="tablaRecintos" prefHeight="260.0">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="80.0"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="220.0"/>
                <TableColumn fx:id="colDireccion" text="Dirección" prefWidth="240.0"/>
                <TableColumn fx:id="colCiudad" text="Ciudad" prefWidth="140.0"/>
            </columns>
        </TableView>
        <GridPane hgap="10.0" vgap="10.0">
            <children>
                <Label text="ID" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtId" editable="false" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Nombre" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtNombre" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Dirección" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txtDireccion" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Ciudad" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="txtCiudad" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </children>
            <!-- ... debajo de la caja de texto txtCiudad en el GridPane ... -->
        </GridPane>


        <!-- PANEL NUEVO PARA AGREGAR LAS ZONAS DE FORMA DINÁMICA -->
        <VBox spacing="8.0" style="-fx-border-color: #cccccc; -fx-border-width: 1px; -fx-padding: 10px;">
            <children>
                <Label text="Configuración de Localidades / Zonas" style="-fx-font-weight: bold;"/>
                <HBox spacing="10.0">
                    <children>
                        <TextField fx:id="txtNombreZona" promptText="Nombre Zona (ej: VIP)"/>
                        <TextField fx:id="txtCapacidadZona" promptText="Capacidad (ej: 100)"/>
                        <TextField fx:id="txtPrecioZona" promptText="Precio Base (ej: 50000)"/>
                        <Button text="Añadir Zona" onAction="#agregarZonaAListaTemporal"/>
                    </children>
                </HBox>

                <!-- LISTA VISUAL CORREGIDA Y TIPADA PARA EVITAR EL CRASH -->
                <ListView fx:id="listaZonasVisuales" prefHeight="100.0">
                    <placeholder>
                        <Label text="No hay zonas añadidas todavía." />
                    </placeholder>
                </ListView>
            </children>
        </VBox>

        <HBox spacing="10.0">
            <children>
                <Button text="Guardar / Actualizar" onAction="#guardarRecinto"/>
                <Button text="Eliminar" onAction="#eliminarRecinto"/>
                <Button text="Limpiar" onAction="#limpiarFormulario"/>
                <Button text="Refrescar" onAction="#cargarRecintos"/>
            </children>
        </HBox>
    </children>
</VBox>

