<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.uniquindio.proyectop2.controladores.administrador.PanelAdministradorControlador">
    <top>
        <HBox spacing="10.0" style="-fx-background-color: #1f2937;" BorderPane.alignment="CENTER_LEFT">
            <children>
                <Label text="Eventos UQ - Panel Administrador" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            </children>
            <padding>
                <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
            </padding>
        </HBox>
    </top>

    <left>
        <VBox spacing="10.0" prefWidth="220.0" style="-fx-background-color: #e5e7eb;">
            <children>
                <Button text="Gestión de usuarios" maxWidth="Infinity" onAction="#cargarVistaUsuarios"/>
                <Button text="Gestión de eventos" maxWidth="Infinity" onAction="#cargarVistaEventos"/>
                <Button text="Gestión de recintos" maxWidth="Infinity" onAction="#cargarVistaRecintos"/>
                <Button text="Reportes" maxWidth="Infinity" onAction="#cargarVistaReportes"/>
                <Button fx:id="btnPerfil" text="Mi Perfil" onAction="#abrirPerfil"/>
            </children>
            <padding>
                <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
            </padding>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contenedorPrincipal" prefWidth="800.0" prefHeight="600.0" />
    </center>
</BorderPane>
